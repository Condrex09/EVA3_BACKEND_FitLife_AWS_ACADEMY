# ==============================================================================
# FitLife - Variables de Entorno (Plantilla de Configuración Oficial EVA 3)
# Basado en la Receta Oficial INACAP para AWS EC2 + Gunicorn + Nginx
# Estudiante: Benjamin Gomez · Sección AP-N4-C1 · INACAP
# ==============================================================================

# Configuración Django
SECRET_KEY=fitlife-secure-prod-key-inacap-2026-eval3

# DEBUG=False en producción AWS EC2; True en desarrollo local
DEBUG=False

# ALLOWED_HOSTS según la receta oficial INACAP (Etapa 4, paso 5)
# El asterisco '*' permite acceder directamente desde cualquier IP pública de EC2
ALLOWED_HOSTS=*

# Orígenes confiables para CSRF (el middleware DynamicCSRFTrustedOriginMiddleware
# añade dinámicamente tu IP pública, pero puedes listar localhost para pruebas)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost

# ------------------------------------------------------------------------------
# Base de Datos PostgreSQL (Requerimiento Criterio 1 de Rúbrica EVA 3)
# En producción AWS EC2 el motor obligatorio es PostgreSQL local en Ubuntu.
# ------------------------------------------------------------------------------
DB_ENGINE=django.db.backends.postgresql
DB_NAME=fitlife_db
DB_USER=fitlife_user
DB_PASSWORD=fitlife_secure_password_2026
DB_HOST=localhost
DB_PORT=5432

# ------------------------------------------------------------------------------
# Credenciales Demo para Demostración en Vivo (Rúbrica EVA 3)
# Deja SHOW_DEMO_CREDENTIALS=True durante la evaluación para facilitar
# el autocompletado en el login y el selector demo en recepción.
# ------------------------------------------------------------------------------
SHOW_DEMO_CREDENTIALS=True
DEMO_ADMIN_USER=admin
DEMO_ADMIN_EMAIL=admin@fitlife.cl
DEMO_ADMIN_PASSWORD=Admin#FitLife2026
DEMO_RECEPTION_USER=recepcion
DEMO_RECEPTION_EMAIL=recepcion@fitlife.cl
DEMO_RECEPTION_PASSWORD=RecepcionFitLife2026!
