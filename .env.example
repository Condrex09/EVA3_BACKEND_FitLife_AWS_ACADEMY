# Configuración Django
# En producción, genera una clave segura ejecutando:
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=cambiar-por-una-clave-secreta-segura-en-produccion-fitlife-2026

# DEBUG=False en producción AWS EC2; True en desarrollo local
DEBUG=True

# Hosts autorizados separados por coma (en EC2 reemplaza TU_IP_PUBLICA_EC2 con la IP asignada)
ALLOWED_HOSTS=localhost,127.0.0.1,TU_IP_PUBLICA_EC2

# Orígenes confiables para CSRF (importante para peticiones POST y fetch con Nginx)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://TU_IP_PUBLICA_EC2

# ------------------------------------------------------------------------------
# Base de Datos PostgreSQL (Requerimiento Criterio 1 de Rúbrica EVA 3)
# En producción AWS EC2 el único motor permitido es PostgreSQL local o RDS.
# ------------------------------------------------------------------------------
DB_ENGINE=django.db.backends.postgresql
DB_NAME=fitlife_db
DB_USER=fitlife_user
DB_PASSWORD=fitlife_secure_password_2026
DB_HOST=localhost
DB_PORT=5432

# ------------------------------------------------------------------------------
# Credenciales Demo para Demostración en Vivo (Rúbrica EVA 3)
# NOTA: Dejar SHOW_DEMO_CREDENTIALS=True durante la evaluación para facilitar
# el autocompletado y pruebas en vivo; cambiar a False al exponer el sitio a internet.
# ------------------------------------------------------------------------------
SHOW_DEMO_CREDENTIALS=True
DEMO_ADMIN_USER=admin
DEMO_ADMIN_EMAIL=admin@fitlife.cl
DEMO_ADMIN_PASSWORD=Admin#FitLife2026
