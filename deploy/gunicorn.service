[Unit]
Description=Gunicorn daemon para FitLife Backend (Receta AWS INACAP)
After=network.target

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/EVA3_BACKEND_Fitlife
EnvironmentFile=/home/ubuntu/EVA3_BACKEND_Fitlife/.env
ExecStart=/home/ubuntu/EVA3_BACKEND_Fitlife/venv/bin/gunicorn \
          --workers 3 \
          --bind unix:/home/ubuntu/EVA3_BACKEND_Fitlife/fitlife.sock \
          config.wsgi:application

[Install]
WantedBy=multi-user.target
